{
  "name": "codex-remote-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "probe": "tsx packages/bridge/src/probe.ts",
    "relay": "tsx packages/relay/src/server.ts",
    "bridge": "tsx packages/bridge/src/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "bridge:control": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/open-bridge-control.ps1"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
